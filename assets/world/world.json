bp","florist":"assets/world/img/dbc95f1ac6feb0.webp","postman":"assets/world/img/1350ba9084c614.webp","barista":"assets/world/img/67d1e39ae863b0.webp","auntie":"assets/world/img/a0fdefdf52fdb1.webp","mechanic":"assets/world/img/0ad2c18e57c0d5.webp","grandpa":"assets/world/img/d54fca88160a09.webp","doctor":"assets/world/img/5aae522f84c1cd.webp","librarian":"assets/world/img/6b9bcb3911ebbd.webp","gardener":"assets/world/img/e2473b78660a33.webp","granny":"assets/world/img/19f226e6fdd659.webp","kid":"assets/world/img/ebccc360117a3a.webp","maki":"assets/world/img/4886562cb81c1f.webp"},"faces":{"baker":"assets/world/img/330473894791ec.webp","florist":"assets/world/img/d68977216c7ccc.webp","postman":"assets/world/img/9178ed4703789c.webp","barista":"assets/world/img/819f5b70269f1b.webp","auntie":"assets/world/img/c87e4aaeff195c.webp","mechanic":"assets/world/img/128bc594963adc.webp","grandpa":"assets/world/img/e62415a5982ee1.webp","doctor":"assets/world/img/b0613ce9ac7c3e.webp","librarian":"assets/world/img/1a1e4b4b7f69a7.webp","gardener":"assets/world/img/6b000b86dceda6.webp","granny":"assets/world/img/1ac3e83a37bab6.webp","kid":"assets/world/img/2954c5bb962e7d.webp","maki":"assets/world/img/217be0659cb9a1.webp"},"cat":"assets/world/img/461b0c0af7d131.webp","ball":"assets/world/img/f5140ddd9397ce.webp"},"season":{"seasons":["spring","summer","autumn","winter"],"names":{"spring":"春","summer":"夏","autumn":"秋","winter":"冬"},"kou":[{"season":"spring","p":0.15,"name":"花信","stamp":"初樱","line":"秋千树比别的樱早开一个礼拜。别的树还是灰的，它已经白了一个梢。","things":["去秘密基地，看全岛最早开的那棵樱","雪人站过的地方，剩下了什么"]},{"season":"spring","p":0.5,"name":"花盛","stamp":"花筏","line":"潭面上的花瓣聚成一条一条的带子，跟着水慢慢转，最后都靠到东岸。","things":["放一只草叶船，让花筏带着它走","蹲下摸一摸化雪的水"]},{"season":"spring","p":0.85,"name":"花吹雪","stamp":"新绳","line":"风一来，整个潭都是斜着走的花。阿钳换了一根新的秋千绳，还是十二股的麻。","things":["帮阿钳把新绳挂上秋千树"]},{"season":"summer","p":0.15,"name":"梅雨","stamp":"雨蛙","line":"树屋漏雨。铁桶接了半桶，一只雨蛙蹲在桶沿上，不肯走。","things":["下雨的时候爬上树屋看看","雨歇的夜里，萤火最多"]},{"season":"summer","p":0.5,"name":"盛夏","stamp":"扑通","line":"抓着绳子荡出去，在最高的地方松手。水比看上去凉得多。","things":["荡秋千，跳进潭里","夜里去糖水树看独角仙"]},{"season":"summer","p":0.85,"name":"晚夏","stamp":"收绳","line":"最后一个走的人收绳子。绳子盘在树枝上，要等明年才放下来。","things":["最后跳一次，帮阿钳把绳子收上树"]},{"season":"autumn","p":0.17,"name":"初秋","stamp":"红梢","line":"全林子只有秋千树先红了一个梢。它春天开得最早，秋天也走得最早。","things":["站在跳台上看秋千树","赤蜻蛉贴着水面点"]},{"season":"autumn","p":0.5,"name":"红叶","stamp":"倒影","line":"潭面像一块深色的玻璃。水里的树比岸上的红。","things":["坐在篝火边的木头上，看对岸的倒影","帮阿钳码柴"]},{"season":"autumn","p":0.83,"name":"落叶","stamp":"烤红薯","line":"扫拢的落叶堆里埋几个红薯，等烟不冒了再扒出来。","things":["把落叶扫成一堆，焖几个红薯"]},{"season":"winter","p":0.15,"name":"初雪","stamp":"薄冰","line":"岸边结了一圈薄冰。石子落上去，咔，咕咚。","things":["往岸边的薄冰上扔一颗石子"]},{"season":"winter","p":0.5,"name":"深雪","stamp":"冰上","line":"潭冻透了。冰在叫。一口气溜出去四格。","things":["在冰上一口气溜出四格","堆一个雪人"]},{"season":"winter","p":0.85,"name":"残雪","stamp":"冰里的叶","line":"冰发灰了，岸边化开一圈。冰底下冻着去年秋天的叶子，一片一片的影子。","things":["在岸边看冰里冻着的叶子"]}],"light":{"spring":{"keys":[[0,246,228,222,0.2,0.45],[0.12,250,248,244,0,0.1],[0.3,255,255,252,0,0],[0.48,255,250,246,0,0],[0.56,255,212,196,0.1,0.8],[0.61,222,168,196,0.45,0.45],[0.66,128,132,206,0.8,0.1],[0.74,62,72,146,1,0],[0.92,62,72,146,1,0],[0.97,156,146,194,0.6,0.3],[1,246,228,222,0.2,0.45]],"hours":[[5.6,0],[6.8,0.12],[9.4,0.3],[12.2,0.42],[17,0.56],[18.1,0.655],[19.1,0.74],[28.4,0.92],[29.6,1]],"sunset":0.635,"sunH":1,"sun":0.72,"shadow":[[150,138,188],[176,140,176]],"shadowK":0.68,"haze":0.12,"humid":0.25,"warm":0.8,"dusk":"#ffc2b0","sat":-0.04,"noon":0.35,"bounce":null,"lampK":1.12,"lampSnow":null,"moonHalo":true,"note":"太阳比夏天低一截、被春霞滤过：直射光七成，影子淡三成、偏紫、边化开；清晨的雾多一倍；正午不发白；傍晚短而粉；夜里是朧月——月亮周围一圈晕。"},"summer":{"keys":[[0,255,222,200,0.2,0.5],[0.12,255,248,238,0,0.15],[0.3,255,255,255,0,0],[0.48,255,252,244,0,0],[0.56,255,198,150,0.12,1],[0.62,214,158,172,0.5,0.5],[0.66,122,136,214,0.8,0.1],[0.74,58,74,150,1,0],[0.92,58,74,150,1,0],[0.97,150,140,190,0.6,0.3],[1,255,222,200,0.2,0.5]],"hours":[[5.5,0],[7,0.12],[9.5,0.3],[12.5,0.42],[17.4,0.56],[18.7,0.6